<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PeakRelay.Installer.Client</RootNamespace>
    <AssemblyName>PeakRelayInstaller-Client</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Installer.Core\Installer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\tools\payload\bepinex.zip" LogicalName="PeakRelay.Installer.Payload.bepinex.zip" />
    <EmbeddedResource Include="..\tools\payload\plugins\Client.zip" LogicalName="PeakRelay.Installer.Payload.plugins.Client.zip" />
  </ItemGroup>

</Project>
