bin/
obj/
*.user
.vs/
*.binlog
*.log

# Recon artifacts kept locally, never committed (regenerate with scripts/decompile.sh)
references/

# Reference assemblies, provisioned by scripts/fetch-libs.sh — never redistribute
# game or framework binaries
lib/

# Local toolchain (portable SDKs, extra runtimes, downloaded archives, dotnet-tools)
tools/

# Installer embed payload (regenerate with scripts/prepare-installer-payload.sh)
Installer.Core/Payload/payload/

# Release output (regenerate with scripts/publish.sh)
dist/

# Local publish output (e.g. manual release builds for deployment testing)
artifacts/
