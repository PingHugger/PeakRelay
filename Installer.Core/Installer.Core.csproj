<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PeakRelay.Installer.Core</RootNamespace>
  </PropertyGroup>

  <!--
    Payload ownership: Installer.Core embeds everything itself, so resource names, the
    names PluginDeployer asks for, and the files on disk live in ONE project.
    LogicalName is derived from the file path (Payload/payload/** ->
    PeakRelay.Installer.Payload.*), which is exactly what PluginDeployer.OpenPayload
    computes — a rename moves both sides together. The payload is produced by
    scripts/prepare-installer-payload.sh; a missing bepinex.zip fails this build, so
    installers cannot build stale.
  -->
  <Target Name="CheckPayloadPresent" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('Payload/payload/bepinex.zip')"
           Text="Installer payload missing: Payload/payload/bepinex.zip (run scripts/prepare-installer-payload.sh first)" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Payload/payload/bepinex.zip"
                      LogicalName="PeakRelay.Installer.Payload.bepinex.zip" />
    <EmbeddedResource Include="Payload/payload/relay.zip"
                      LogicalName="PeakRelay.Installer.Payload.relay.relay.zip" />
    <EmbeddedResource Include="Payload/payload/plugins/Dedicated/*.dll"
                      LogicalName="PeakRelay.Installer.Payload.plugins.Dedicated.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Payload/payload/plugins/Client/*.dll"
                      LogicalName="PeakRelay.Installer.Payload.plugins.Client.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
