<Project>

  <!--
    Single source of truth for version + shared build settings across every project.
    Bump <Version> here only; installers/launcher show it via AssemblyInformationalVersion,
    plugins derive their BepInEx version from it, CI tags drive releases from it.
  -->
  <PropertyGroup>
    <Version>0.7.9</Version>
    <Authors>PingHugger</Authors>
    <Product>PeakRelay</Product>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
