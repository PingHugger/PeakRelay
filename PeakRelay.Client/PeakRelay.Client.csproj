<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>PeakRelay.Client</RootNamespace>
  </PropertyGroup>

  <!-- Single version source: generate the const the [BepInPlugin] attribute needs -->
  <Target Name="GenerateVersionConst" BeforeTargets="BeforeBuild;CoreCompile">
    <PropertyGroup>
      <BuildVersionLine>namespace PeakRelay.Client%3B internal static class BuildVersion %7B public const string Version = "$(Version)"%3B %7D</BuildVersionLine>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Version.g.cs" Lines="$(BuildVersionLine)" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)Version.g.cs" /></ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\PeakRelay.Protocol\PeakRelay.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>..\lib\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>..\lib\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- game framework + UI stack (server browser page, Zorro UI page system) -->
    <Reference Include="Photon">
      <HintPath>..\lib\Photon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.UI.Runtime">
      <HintPath>..\lib\Zorro.UI.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.Core.Runtime">
      <HintPath>..\lib\Zorro.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\lib\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\lib\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\lib\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\lib\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\lib\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>..\lib\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\lib\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
