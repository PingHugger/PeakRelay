<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PeakRelay.Dedicated</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PeakRelay.Protocol\PeakRelay.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>..\lib\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>..\lib\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>..\lib\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\lib\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- game assemblies needed for NetworkConnector/HostState/ConnectionService/GameHandler -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.Core.Runtime">
      <HintPath>..\lib\Zorro.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utilities">
      <HintPath>..\lib\Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Platforms">
      <HintPath>..\lib\Platforms.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Steamworks.NET + game Steam runtime + Unity play-mode tags (no-Steam dedicated mode) -->
    <Reference Include="Steamworks.NET">
      <HintPath>..\lib\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamCommon">
      <HintPath>..\lib\SteamCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.MultiplayerModule">
      <HintPath>..\lib\UnityEngine.MultiplayerModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- game-shipped JSON stack for server.json parsing -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
