<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>PeakRelay.Dedicated</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PeakRelay.Dedicated.Tests" />
  </ItemGroup>

  <!-- Single version source: generate the const the [BepInPlugin] attribute needs -->
  <Target Name="GenerateVersionConst" BeforeTargets="BeforeBuild;CoreCompile">
    <PropertyGroup>
      <BuildVersionLine>namespace PeakRelay.Dedicated%3B internal static class BuildVersion %7B public const string Version = "$(Version)"%3B %7D</BuildVersionLine>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Version.g.cs" Lines="$(BuildVersionLine)" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)Version.g.cs" /></ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\PeakRelay.Protocol\PeakRelay.Protocol.csproj" />
  </ItemGroup>

  <!-- Documented example for the operator-facing gamemodes folder (shipped on publish) -->
  <ItemGroup>
    <None Include="..\gamemodes\SAMPLE-custom.txt" Link="gamemodes\SAMPLE-custom.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>..\lib\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>..\lib\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>..\lib\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\lib\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- game assemblies needed for NetworkConnector/HostState/ConnectionService/GameHandler -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.Core.Runtime">
      <HintPath>..\lib\Zorro.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utilities">
      <HintPath>..\lib\Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Platforms">
      <HintPath>..\lib\Platforms.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Steamworks.NET + game Steam runtime + Unity play-mode tags (no-Steam dedicated mode) -->
    <Reference Include="Steamworks.NET">
      <HintPath>..\lib\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamCommon">
      <HintPath>..\lib\SteamCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.MultiplayerModule">
      <HintPath>..\lib\UnityEngine.MultiplayerModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- game-shipped JSON stack for server.json parsing -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
